# =============================================
# FILE NÀY LÀ TEMPLATE - DÙNG ĐỂ THAM KHẢO
# Sao chép thành file .env rồi điền giá trị thật
# KHÔNG điền giá trị thật vào file này
# =============================================

# --- FIREBASE ---
# Lấy từ: Firebase Console > Project Settings > Your apps > SDK config
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# --- EMAILJS ---
# Lấy từ: emailjs.com > Dashboard > Email Services + Templates
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
